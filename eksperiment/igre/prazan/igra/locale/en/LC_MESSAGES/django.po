msgstr "Log"

msgid "Обрисати резултат?"
msgstr "Delete this result?"

msgid "Брисање је коначно: резултат нестаје са ранг листе и играч не може поново да сачува ову партију."
msgstr "Deletion is final: the result leaves the leaderboard and the player cannot save this game again."

msgid "Обрисати линк?"
msgstr "Delete this link?"

msgid "Брисање је коначно: линк престаје да ради и за ову партију се не прави нови. Резултат на ранг листи остаје."
msgstr "Deletion is final: the link stops working and no new link is made for this game. The leaderboard result stays."

msgid "Брисање се бележи у дневник, са твојим именом и временом."
msgstr "Deletions are recorded in the log, with your name and the time."

msgid "Одустани"
msgstr "Cancel"

msgid "Обриши"
msgstr "Delete"

msgid "Пријава модератора"
msgstr "Moderator sign-in"

msgid "Пријави се"
msgstr "Sign in"

msgid "Играчима налог није потребан."
msgstr "Players do not need an account."

msgid "Назад на игру"
msgstr "Back to the game"

msgid "Резултати на ранг листи"
msgstr "Leaderboard results"

