msgstr "re-enabled a moderator"

msgid "Име налога је обавезно."
msgstr "Username is required."

msgid "Лозинка је обавезна."
msgstr "Password is required."

msgid "Лозинке се не поклапају."
msgstr "The passwords do not match."

msgid "Не можеш да искључиш сопствени налог."
msgstr "You cannot disable your own account."

#, python-format
msgid "Име налога може имати највише %(broj)s знакова."
msgstr "Username can be at most %(broj)s characters long."

msgid "Име налога сме да има само слова, цифре и знакове @ . + - _."
msgstr "Username may contain only letters, digits and @ . + - _."

msgid "Налог са тим именом већ постоји."
msgstr "An account with that username already exists."

msgid "Резултат је обрисан."
msgstr "The result was deleted."

msgid "Линк је обрисан."
msgstr "The link was deleted."

msgid "Модератор је додат."
msgstr "The moderator was added."

msgid "Модератор је искључен."
msgstr "The moderator was disabled."

msgid "Модератор је поново укључен."
msgstr "The moderator was re-enabled."

msgid "Превише неуспелих покушаја. Покушај поново за 15 минута."
msgstr "Too many failed attempts. Try again in 15 minutes."

msgid "Погрешно име или лозинка."
msgstr "Wrong username or password."

msgid "Потребна је пријава модератора."
msgstr "Moderator sign-in required."

msgid "Резултат не постоји или је већ обрисан."
msgstr "The result does not exist or was already deleted."

msgid "Линк не постоји или је већ обрисан."
msgstr "The link does not exist or was already deleted."

msgid "Модератор не постоји."
msgstr "The moderator does not exist."

msgid "Модератор је уклонио резултат ове партије."
msgstr "A moderator removed the result of this game."

msgid "Модератор је уклонио резултат ове партије са ранг листе."
msgstr "A moderator removed the result of this game from the leaderboard."

msgid "Модератор је уклонио линк за дељење ове партије."
msgstr "A moderator removed the share link of this game."

