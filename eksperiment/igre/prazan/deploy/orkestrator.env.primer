# Podesavanja Orkestratora na serveru. Kopirati u /etc/orkestrator/orkestrator.env
# (vlasnik root, grupa orkestrator, prava 640) i popuniti. Vidi deploy/UPUTSTVO.md, korak 4.

# Tajni kljuc: bar 50 nasumicnih znakova, razlicit na svakom serveru, nikome se ne salje.
# Pravi se komandom:  python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Promena kljuca odjavljuje sve moderatore i prekida partije u toku.
ORKESTRATOR_SECRET_KEY=

ORKESTRATOR_DOMEN=orkestrator.example
ORKESTRATOR_BAZA=/var/lib/orkestrator/db.sqlite3
ORKESTRATOR_STATIC=/srv/orkestrator/static

# Broj gunicorn procesa. 3 je dovoljno za nekoliko hiljada igraca dnevno.
ORKESTRATOR_PROCESA=3
