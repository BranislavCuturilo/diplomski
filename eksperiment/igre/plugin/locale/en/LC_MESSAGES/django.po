#: .\igra\parametri.py
msgid "Превод почетне стране"
msgstr "Home page translation"

#: .\igra\parametri.py
msgid "Шаблон листе и форме"
msgstr "List and form template"

#: .\igra\parametri.py
msgid "CSS и прилагођавање телефону"
msgstr "CSS and phone adaptation"

#: .\igra\parametri.py
msgid "CRUD прикази"
msgstr "CRUD screens"

#: .\igra\parametri.py
msgid "Модел података и миграција"
msgstr "Data model and migration"

#: .\igra\parametri.py
msgid "Провера права приступа"
msgstr "Access rights check"

#: .\igra\parametri.py
msgid "Аутоматски тестови"
msgstr "Automated tests"

#: .\igra\parametri.py
msgid "Безбедносна ревизија"
msgstr "Security review"

#: .\igra\parametri.py
msgid "најјефтинији и најбржи"
msgstr "cheapest and fastest"

#: .\igra\parametri.py
msgid "средњи по цени и брзини"
msgstr "medium in price and speed"

#: .\igra\parametri.py
msgid "најскупљи и најспорији, најпоузданији"
msgstr "most expensive and slowest, most reliable"

#: .\igra\parametri.py
msgid "кратко размишљање: јефтино и брзо, слабије на захтевнијем послу"
msgstr "short thinking: cheap and fast, weaker on demanding work"

#: .\igra\parametri.py
msgid "пажљиво размишљање: уобичајен избор"
msgstr "careful thinking: the usual choice"

#: .\igra\parametri.py
msgid "најдуже размишљање: знатно скупље и спорије"
msgstr "longest thinking: much more expensive and slower"

#. Translators: kontekst koji agent dobija: malo, samo najnuzniji delovi projekta.
#: .\igra\parametri.py
msgid "мало"
msgstr "small"

#: .\igra\parametri.py
msgid "само најнужније: јефтиније, али агент може да промаши"
msgstr "only the essentials: cheaper, but the agent may miss things"

#. Translators: kontekst koji agent dobija: taman, upravo koliko zadatku treba.
#: .\igra\parametri.py
msgid "таман"
msgstr "just right"

#: .\igra\parametri.py
msgid "оно што задатку треба"
msgstr "what the task needs"

#. Translators: kontekst koji agent dobija: sve, ceo projekat.
#: .\igra\parametri.py
msgid "све"
msgstr "all"

#: .\igra\parametri.py
msgid "цео пројекат: скупље и расплинуто"
msgstr "the whole project: more expensive and diffuse"

#. Translators: podela posla: jedan agent radi sam.
#: .\igra\parametri.py
msgid "сам"
msgstr "alone"

#: .\igra\parametri.py
msgid "један агент ради редом"
msgstr "one agent works in sequence"

#. Translators: podela posla: tri agenta rade uporedo.
#: .\igra\parametri.py
msgid "3 агента"
msgstr "3 agents"

#: .\igra\parametri.py
msgid "три агента упоредо: брже, нешто скупље"
msgstr "three agents in parallel: faster, somewhat more expensive"

#. Translators: podela posla: pedeset agenata rade uporedo.
#: .\igra\parametri.py
msgid "50 агената"
msgstr "50 agents"

#: .\igra\parametri.py
msgid "педесет агената: много скупље, а усклађивање траје"
msgstr "fifty agents: much more expensive, and coordination takes time"

#: .\igra\parametri.py
msgid "одличан оркестратор"
msgstr "excellent orchestrator"

#: .\igra\parametri.py
msgid "солидан"
msgstr "solid"

#. Translators: ocena: igrac je skupo platio lekciju (doslovno "skup ucitelj").
#: .\igra\parametri.py
msgid "скуп учитељ"
msgstr "costly lesson"

#. Translators: najlosija ocena (doslovno "pozar").
#: .\igra\parametri.py
msgid "пожар"
msgstr "disaster"

#. Translators: status kruga: zadatak je zavrsen.
#: .\igra\parametri.py
msgid "готово"
msgstr "done"

#: .\igra\parametri.py
msgid "враћено на дораду"
msgstr "sent back for rework"

#: .\igra\parametri.py
msgid ""
"Цене и нивои размишљања су стварни подаци; вероватноће, казне и поени су "
"измишљени параметри игре."
msgstr ""
"Prices and thinking levels are real data; probabilities, penalties and "
"points are made-up game parameters."

#: .\igra\parametri.py
msgid "Ако је грешка тиха, задатак остаје највишем разреду."
msgstr "If an error is silent, the task stays with the top tier."

#: .\igra\parametri.py
msgid "Најскупљи модел није увек најбољи избор."
msgstr "The most expensive model is not always the best choice."

#: .\igra\parametri.py
msgid "Изнад нивоа high цена расте, а квалитет не."
msgstr "Above the high level, cost goes up but quality does not."

#: .\igra\parametri.py
msgid "Превише контекста квари резултат исто као премало."
msgstr "Too much context spoils the result just as much as too little."

#: .\igra\parametri.py
msgid "Више агената не значи јефтиније."
msgstr "More agents does not mean cheaper."

#: .\igra\tekstovi.py
msgid "Стање је освежено."
msgstr "State refreshed."

#: .\igra\tekstovi.py
msgid "Партија више не постоји. Освежите страну за нову игру."
msgstr "This game no longer exists. Refresh the page to start a new game."

#: .\igra\tekstovi.py
msgid "Захтев није исправан. Освежите страну."
msgstr "The request is not valid. Refresh the page."

#: .\igra\tekstovi.py
msgid "Сервер није одговорио како треба. Покушајте поново."
msgstr "The server did not respond properly. Try again."

#: .\igra\tekstovi.py .\templates\igra\igra.html
msgid "Стање игре није могло да се прочита. Освежите страну."
msgstr "The game state could not be read. Refresh the page."

#: .\igra\tekstovi.py
msgid "Резултат је сачуван."
msgstr "Result saved."

#: .\igra\tekstovi.py
msgid "Ово име није дозвољено. Изаберите друго име."
msgstr "This name is not allowed. Choose another name."

#: .\igra\tekstovi.py
msgid "Ова партија је већ сачувана."
msgstr "This game has already been saved."

#: .\igra\tekstovi.py
msgid "Партија још није завршена. Освежите страну."
msgstr "The game is not finished yet. Refresh the page."

#: .\igra\tekstovi.py
msgid "Линк за ову партију више није доступан."
msgstr "The link for this game is no longer available."

#: .\igra\tekstovi.py
msgid "Линк је копиран."
msgstr "Link copied."

#: .\igra\tekstovi.py
msgid "Копирање није успело. Линк је означен; копирајте га ручно."
msgstr "Copying failed. The link is selected; copy it manually."

#: .\igra\tekstovi.py .\templates\igra\deljeno.html
msgid "Резултат није могао да се прочита."
msgstr "The result could not be read."

#: .\igra\tekstovi.py
msgid "Изаберите све четири опције да видите процену."
msgstr "Choose all four options to see the estimate."

#: .\igra\tekstovi.py
msgid "Пријава је примљена. Хвала."
msgstr "Report received. Thank you."

#: .\igra\tekstovi.py
msgid "Овај резултат више није на ранг листи. Освежите страну."
msgstr "This result is no longer on the leaderboard. Refresh the page."

#: .\igra\tekstovi.py
msgid "Започети нову игру? Текућа партија се губи."
msgstr "Start a new game? The current game will be lost."

#. Translators: naziv igre (na engleskom "Orchestrator", odluka J3).
#: .\igra\tekstovi.py .\templates\400.html .\templates\403.html
#: .\templates\403_csrf.html .\templates\404.html .\templates\500.html
#: .\templates\igra\deljeno.html .\templates\igra\igra.html
#: .\templates\igra\moderator\osnova.html
msgid "Оркестратор"
msgstr "Orchestrator"

#: .\igra\tekstovi.py
msgid "Мој резултат у игри Оркестратор"
msgstr "My result in the game Orchestrator"

#. Translators: %(krug)s je redni broj kruga, %(ukupno)s ukupan broj krugova.
#: .\igra\tekstovi.py
#, python-format
msgid "Круг %(krug)s од %(ukupno)s"
msgstr "Round %(krug)s of %(ukupno)s"

#: .\igra\tekstovi.py
msgid "Игра је завршена"
msgstr "Game over"

#. Translators: rezultat poslednjeg kruga; %(zadatak)s je naziv zadatka.
#: .\igra\tekstovi.py
#, python-format
msgid "Круг %(krug)s: %(zadatak)s"
msgstr "Round %(krug)s: %(zadatak)s"

#. Translators: %(cena)s je iznos sa oznakom valute, %(minuti)s broj minuta sa jedinicom.
#: .\igra\tekstovi.py
#, python-format
msgid "Процена: цена %(cena)s, %(minuti)s."
msgstr "Estimate: cost %(cena)s, %(minuti)s."

#. Translators: tiha greska na zavrsnom ekranu; %(cena)s i %(minuti)s su dodatak sa jedinicom.
#: .\igra\tekstovi.py
#, python-format
msgid "Круг %(krug)s: %(zadatak)s (додатак: %(cena)s, %(minuti)s)"
msgstr "Round %(krug)s: %(zadatak)s (extra: %(cena)s, %(minuti)s)"

#. Translators: odeljak zavrsnog rada uz lekciju, npr. 4.2.
#: .\igra\tekstovi.py
#, python-format
msgid "(одељак %(odeljak)s)"
msgstr "(section %(odeljak)s)"

#. Translators: %(datum)s je dan isteka linka za deljenje.
#: .\igra\tekstovi.py
#, python-format
msgid "Линк важи до %(datum)s."
msgstr "Link valid until %(datum)s."

#: .\igra\tekstovi.py .\templates\igra\moderator\nalozi.html
#: .\templates\igra\moderator\prijava.html
msgid "Корисничко име"
msgstr "Username"

#: .\igra\tekstovi.py .\templates\igra\moderator\nalozi.html
#: .\templates\igra\moderator\osnova.html
#: .\templates\igra\moderator\prijava.html
msgid "Лозинка"
msgstr "Password"

#: .\igra\tekstovi.py .\templates\igra\moderator\nalog.html
msgid "Нова лозинка"
msgstr "New password"

#: .\igra\tekstovi.py .\templates\igra\moderator\nalog.html
#: .\templates\igra\moderator\nalozi.html
msgid "Лозинка поново"
msgstr "Password again"

#: .\igra\tekstovi.py .\templates\igra\moderator\dnevnik.html
#: .\templates\igra\moderator\nalog.html .\templates\igra\moderator\nalozi.html
msgid "Главни модератор"
msgstr "Head moderator"

#: .\igra\tekstovi.py .\templates\igra\moderator\nalog.html
#: .\templates\igra\moderator\nalozi.html
msgid "Ваша лозинка"
msgstr "Your password"

#: .\igra\tekstovi.py
msgid "Погрешно корисничко име или лозинка."
msgstr "Wrong username or password."

#: .\igra\tekstovi.py
msgid "Погрешна лозинка."
msgstr "Wrong password."

#: .\igra\tekstovi.py
msgid "Нова лозинка мора да се разликује од старе."
msgstr "The new password must be different from the old one."

#. Translators: %(n)s je broj minuta do kraja blokade.
#: .\igra\tekstovi.py .\templates\igra\moderator\prijava.html
#, python-format
msgid "Превише неуспешних покушаја. Покушајте поново за %(n)s минут."
msgid_plural "Превише неуспешних покушаја. Покушајте поново за %(n)s минута."
msgstr[0] "Too many failed attempts. Try again in %(n)s minute."
msgstr[1] "Too many failed attempts. Try again in %(n)s minutes."

#. Translators: %(n)s je broj mesta na rang listi.
#: .\igra\tekstovi.py
#, python-format
msgid "Резултат је сачуван, али није међу %(n)s најбољим."
msgid_plural "Резултат је сачуван, али није међу %(n)s најбољих."
msgstr[0] "The result is saved, but it is not in the top %(n)s."
msgstr[1] "The result is saved, but it is not in the top %(n)s."

#. Translators: %(n)s je najveci broj znakova imena.
#: .\igra\tekstovi.py
#, python-format
msgid ""
"Име мора имати од 1 до %(n)s знака, без размака на почетку и крају и без "
"невидљивих знакова."
msgid_plural ""
"Име мора имати од 1 до %(n)s знакова, без размака на почетку и крају и без "
"невидљивих знакова."
msgstr[0] ""
"The name must have 1 to %(n)s character, with no spaces at the start or end "
"and no invisible characters."
msgstr[1] ""
"The name must have 1 to %(n)s characters, with no spaces at the start or end "
"and no invisible characters."

#. Translators: %(procenat)s je prekoracenje budzeta u procentima, vec sa znakom %; %(kazna)s je
#. broj izgubljenih poena.
#: .\igra\tekstovi.py
#, python-format
msgid "Буџет је прекорачен за %(procenat)s (−%(kazna)s поен)."
msgid_plural "Буџет је прекорачен за %(procenat)s (−%(kazna)s поена)."
msgstr[0] "Budget exceeded by %(procenat)s (−%(kazna)s point)."
msgstr[1] "Budget exceeded by %(procenat)s (−%(kazna)s points)."

