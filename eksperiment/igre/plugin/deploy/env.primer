# Orkestrator: primer .env (DEPLOY.md, korak 3).
#   cp deploy/env.primer /opt/orkestrator/.env && chmod 600 /opt/orkestrator/.env
# .env se NIKAD ne stavlja u git, arhivu ni poruku. Vrednosti pisati bez navodnika i bez znaka $
# (compose ga tumaci kao promenljivu).
#
# Ne upisuju se ovde, postavlja ih compose.yaml iz DOMEN: DJANGO_ALLOWED_HOSTS, DJANGO_CSRF_TRUSTED_ORIGINS,
# DJANGO_BAZA (/data/db.sqlite3). DJANGO_SETTINGS_MODULE je u slici (orkestrator.settings_prod).

# Oznaka izdanja iz imena arhive; slike se zovu orkestrator-app:<VERZIJA> i orkestrator-web:<VERZIJA>.
VERZIJA=v1.0.0

# Stvarni domen klijenta, bez https:// i bez kose crte. orkestrator.example je rezervisano ime (RFC 2606):
# za njega sertifikat ne postoji, pa OBAVEZNO zameniti.
DOMEN=orkestrator.example

# Tajni kljuc: openssl rand -hex 40
# Kopija ide van servera (menadzer lozinki klijenta). Gubitak ili promena brise sve sesije i partije u toku
# i odjavljuje moderatore. Isti kljuc ostaje kroz sve verzije. Prazno: aplikacija ne krece.
DJANGO_SECRET_KEY=

# HSTS: prvih 14 dana 3600; 31536000 tek posle odobrenja klijenta (DEPLOY.md, 11). Smanjenje ne vraca pregledace.
# Samo cifre, bez razmaka, vece od 0, bez vodece nule; app i web inace ne krecu (isti niz cita i Nginx).
DJANGO_HSTS_SEKUNDI=3600

# Kopije baze na domacinu (NISU sifrovane): install -d -m 0700 -o 10001 -g 10001 <putanja>
KOPIJE_DIR=/var/backups/orkestrator

# Sifrovane kopije za van servera: van KOPIJE_DIR, samo root (install -d -m 0700 -o root -g root <putanja>).
KOPIJE_VAN_SERVERA_DIR=/var/backups/orkestrator-van-servera

# Adresa za obavestenja Let's Encrypt-a o isteku sertifikata.
LETSENCRYPT_EMAIL=

# Pun otisak (fingerprint, 40 heksa znakova, bez razmaka) javnog gpg kljuca kojim se sifruje nedeljna kopija za
# van servera (DEPLOY.md, 9). ID ili adresa se ne prihvataju.
KOPIJA_GPG_PRIMALAC=
